# Copiar como .env

# Simula el pago en el navegador, sin llamar a POST /api/pagos.
# El backend ya implementa el contrato de docs/api-senias.md, así que en false el
# flujo completo pasa por la API. Poner en true solo para trabajar en el frontend
# sin levantar el backend.
VITE_USE_MOCK=false

# URL base de la API. Si no se define, se usa http://localhost:3000/api.
VITE_API_URL=http://localhost:3000/api
