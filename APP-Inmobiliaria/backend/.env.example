# Copiá este archivo a `.env` y completá los valores.
# El `.env` real está en .gitignore: nunca lo subas al repo.

# Clave con la que se firman los tokens de sesión (JWT). OBLIGATORIA:
# el servidor no arranca sin ella, y tampoco acepta el valor "secret".
#
# Generá la tuya con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Base de datos. Este es el valor por defecto y apunta al servicio `mysql-app`
# de docker-compose.yml, así que en desarrollo podés dejarlo comentado.
# DATABASE_URL=mysql://dsw:dsw@127.0.0.1:3307/app-inmobiliaria

# Puerto del servidor. Por defecto 3000, que es el que espera el frontend.
# PORT=3000
