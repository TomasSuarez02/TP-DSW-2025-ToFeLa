
### obtener todas las propiedades
GET http://localhost:3000/api/propiedades

### crear una nueva propiedad
# @name createPropiedad
POST http://localhost:3000/api/propiedades
Content-Type: application/json

{
    "id": 5,
    "direccion": "Av. Cordoba 900",
    "superficie": "120m2",
    "precio": 150000,
    "descripcion": "Casa con pileta",
    "tipoPropiedad":  "1",
    "estado": "disponible",
    "hora_desde": "19:00:00",
    "hora_hasta": "21:00:00",
    "inmobiliaria": "1"
}

### ID
@id = {{createPropiedad.response.body.data.id}}

### obtener una propiedad
GET http://localhost:3000/api/propiedades/{{id}}

### modificar una propiedad (PUT - recurso completo e idempotente)
PUT http://localhost:3000/api/propiedades/{{id}}
Content-Type: application/json

{
    "id": 1,
    "direccion": "Av. Siempre Viva 742",
    "superficie": "120m2",
    "precio": 160000,
    "descripcion": "Casa familiar renovada",
    "estado": "reservada"
}

### modificar una propiedad (PATCH - recurso parcial)
PATCH http://localhost:3000/api/propiedades/{{id}}
Content-Type: application/json

{
    "precio": 155000,
    "tipoPropiedad":  "1",
    "inmobiliaria": "1"
}

# @name createPropiedadToDelete
POST http://localhost:3000/api/propiedades
Content-Type: application/json

{
    "id": 2,
    "direccion": "Calle Falsa 123",
    "superficie": "80m2",
    "precio": 90000,
    "descripcion": "Departamento céntrico",
    "estado": "disponible"
}

### borrar una propiedad
@idToDelete = {{createPropiedadToDelete.response.body.data.id}}
DELETE http://localhost:3000/api/propiedades/{{idToDelete}}
